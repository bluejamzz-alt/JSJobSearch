# Copy to .env for local runs. On GitHub Actions, set these as repository secrets instead.

# --- Email delivery (Gmail: use an App Password, not your login password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=bluejamzz@gmail.com

# --- Optional job sources that need a free API key ---
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Optional AI grading ---
ANTHROPIC_API_KEY=

# --- Optional Telegram push ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
